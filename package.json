{
  "name": "anselmotech-social",
  "version": "1.0.0",
  "description": "AnselmoTech Social — gerenciador do Instagram profissional @anselmo.tech (Composio + IA)",
  "type": "module",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --experimental-test-module-mocks test/*.test.js",
    "check": "for f in server/*.js public/*.js; do node --check $f || exit 1; done && echo ok"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@composio/core": "^0.29.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  }
}
