# Copie para .env e preencha. O arquivo .env NUNCA vai para o git.

# --- Composio (obrigatório para dados do Instagram) ---
# Chave do projeto em https://dashboard.composio.dev (Settings > API Keys)
COMPOSIO_API_KEY=
# user_id (entity) do Composio que tem a conexão do Instagram
COMPOSIO_USER_ID=
# Opcional: ID da conta conectada (começa com "ca_"). Se vazio, o app usa a primeira conta ACTIVE do Instagram desse usuário.
COMPOSIO_INSTAGRAM_ACCOUNT_ID=
# Opcional (recomendado): versão fixa do toolkit Instagram (ex.: 20251027_00). Se vazio, usa a versão "latest".
COMPOSIO_INSTAGRAM_VERSION=

# --- IA (opcional) ---
# Sem chave, o app usa um gerador local de sugestões (mais simples).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Servidor ---
PORT=3000
# 127.0.0.1 = só no seu computador. Use 0.0.0.0 para abrir no celular na mesma rede (defina APP_PASSWORD!).
HOST=127.0.0.1
# Se definido, o app pede usuário/senha (usuário: anselmo). Obrigatório se HOST não for 127.0.0.1.
APP_PASSWORD=

# Legenda: a documentação da ferramenta do Composio pede '#' codificado como %23.
# Mantenha true, a menos que sua primeira publicação mostre "%23" no lugar de "#".
CAPTION_ENCODE_HASHTAGS=true

# --- Agendamento ---
# Se o servidor estava desligado no horário, publica até este atraso (minutos). Depois disso, marca erro e não publica.
PUBLISH_GRACE_MINUTES=360
# Pasta da fila/rascunhos (padrão: ./data)
DATA_DIR=

# --- Upload opcional de mídia (Supabase Storage, bucket PÚBLICO) ---
# Sem isso, cole URLs públicas diretas (.jpg / .mp4) no editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
